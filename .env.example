# Railway / Hosting
PORT=8000

# Anthropic API (para resúmenes post-llamada con Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Notion (CRM)
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID_CONTACTS=your_database_id_here
NOTION_DATABASE_ID_CALLS=your_database_id_here

# Cal.com (agendamiento de citas)
CALCOM_API_KEY=your_calcom_api_key_here

# Retell AI (agente de voz)
RETELL_API_KEY=your_retell_api_key_here
RETELL_WEBHOOK_SECRET=your_webhook_secret_here

# Twilio (telefonía)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_phone_number_here

# URLs (para webhooks de Retell/Twilio)
RAILWAY_URL=your_railway_url_here
